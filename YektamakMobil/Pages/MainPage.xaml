<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:YektamakMobil.PageModels"
             x:Class="YektamakMobil.Pages.MainPage"
             x:DataType="pageModels:MainPageModel">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label x:Name="lblMessage" Text="{Binding message}" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>