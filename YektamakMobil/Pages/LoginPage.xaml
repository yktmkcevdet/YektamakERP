<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:YektamakMobil.PageModels"
             x:Class="YektamakMobil.Pages.LoginPage"
             x:DataType="pageModels:LoginViewModel">

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Entry x:Name="txtUsername" Placeholder="Kullanıcı Adı" Text="{Binding msername}" />
        <Entry x:Name="txtPassword" Placeholder="Şifre" IsPassword="True" Text="{Binding password}" />
        <Button Text="Giriş" Clicked="OnLoginClicked" />

        <Label x:Name="lblMessage" Text="{Binding message}" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>