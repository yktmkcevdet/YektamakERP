@inherits LayoutComponentBase
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- Sol Drawer -->
    <MudDrawer @bind-Open="_drawerOpen"
               Anchor="Anchor.Left"
               Elevation="2"
               Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        
        <MudAppBar Color="Color.Primary" Elevation="4">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="ml-2">Yektamak</MudText>
            <MudSpacer />
            <AuthorizeView>
                <Authorized>
                    <MudText Class="mr-4">Hoş geldin, @context.User.Identity.Name</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LogOut">Çıkış Yap</MudButton>
                </Authorized>
            </AuthorizeView>
        </MudAppBar>

        <!-- Sayfa içeriği -->
        <div class="p-4">
            @Body
        </div>
    </MudMainContent>

</MudLayout>


@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void LogOut()
    {
        // logout işlemleri
    }
}
