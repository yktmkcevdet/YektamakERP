@using BlazorApp1.Features.Commands.Account.Login
@using ApiService.Interfaces
@using YektamakWeb.Components.Dialogs
@using YektamakWeb.Pages
@using Models.DTO
@using YektamakWeb.Commands.Accounts
@using System.Security.Claims

@inherits LayoutComponentBase
@inject ICache _cache
@inject CustomAuthStateProvider authStateProvider
@inject NavigationManager Navigation

    <MudNavMenu Class="mud-width-full">
        <MudText Typo="Typo.h6" Class="px-4">YEKTAMAK</MudText>
        <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">menu</MudText>
        <MudDivider Class="my-2" />

        <AuthorizeView>
            <Authorized>
            @foreach (var item in _cache.anaMenuList)
            {
                <MudNavGroup Title=@item.ad Expanded="false" Icon=@Icons.Material.Filled.Settings>
                    @foreach(var detail in _cache.yetkiList.Where(y=>y.menu.Id==item.Id))
                    {
                        <MudNavLink OnClick="@(() => Navigate($"/{detail.ekran.ekranAdi}"))">
                            <MudIcon Icon=@Icons.Material.Filled.Settings />
                            @detail.ekran.ekranAdi
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
            </Authorized>
        </AuthorizeView>
    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>

    </MudNavMenu>

@code {
    bool _drawerOpen = true;
    void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void Navigate(string url)
    {
        // sadece Body güncellenir, tam sayfa refresh olmaz
        Navigation.NavigateTo(url);
    }
}

