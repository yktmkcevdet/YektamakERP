<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- İstek çalıştırma süresi (saniye) -->
    <httpRuntime executionTimeout="600" maxRequestLength="2097151" />
  </system.web>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\Api.exe" arguments=".\FinansalTakipWebApiCore.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
